{
  "name": "agentforge-desktop",
  "version": "0.1.0",
  "description": "An open-source Electron desktop workbench for learning and building AI coding agents.",
  "main": ".vite/build/main.js",
  "author": "LiutingtingEngineer",
  "license": "MIT",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run package",
    "package": "npm run typecheck && electron-forge package",
    "make": "npm run typecheck && electron-forge make",
    "make:mac": "npm run typecheck && electron-forge make --platform=darwin"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
